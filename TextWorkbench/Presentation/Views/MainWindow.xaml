<Window x:Class="TextWorkbench.Presentation.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TextWorkbench.Presentation.Views"
        xmlns:viewModels="clr-namespace:TextWorkbench.Presentation.ViewModels"
        mc:Ignorable="d"
        Title="TextWorkbench" Height="600" Width="1000">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Menu -->
        <Menu Grid.Row="0">
            <MenuItem Header="ファイル(_F)">
                <MenuItem Header="新規(_N)" Command="{Binding NewCommand}"/>
                <MenuItem Header="開く(_O)" Command="{Binding OpenCommand}"/>
                <MenuItem Header="保存(_S)" Command="{Binding SaveCommand}"/>
                <MenuItem Header="名前を付けて保存(_A)" Command="{Binding SaveAsCommand}"/>
                <Separator/>
                <MenuItem Header="閉じる(_C)" Command="{Binding CloseCommand}"/>
                <Separator/>
                <MenuItem Header="終了(_X)" Command="{Binding ExitCommand}"/>
            </MenuItem>
            <MenuItem Header="編集(_E)">
                <MenuItem Header="元に戻す(_U)" Command="Undo"/>
                <MenuItem Header="やり直す(_R)" Command="Redo"/>
                <Separator/>
                <MenuItem Header="切り取り(_T)" Command="Cut"/>
                <MenuItem Header="コピー(_C)" Command="Copy"/>
                <MenuItem Header="貼り付け(_P)" Command="Paste"/>
                <Separator/>
                <MenuItem Header="すべて選択(_A)" Command="SelectAll"/>
            </MenuItem>
            <MenuItem Header="検索(_S)">
                <MenuItem Header="検索(_F)" Command="{Binding SearchCommand}"/>
                <MenuItem Header="置換(_R)" Command="{Binding ReplaceCommand}"/>
            </MenuItem>
            <MenuItem Header="比較(_C)">
                <MenuItem Header="ファイルを比較(_C)" Command="{Binding CompareCommand}"/>
            </MenuItem>
        </Menu>

        <!-- QuickActions -->
        <ToolBar Grid.Row="1" Padding="4">
            <Button Command="{Binding NewCommand}" ToolTip="新規作成">
                <TextBlock Text="新規"/>
            </Button>
            <Button Command="{Binding OpenCommand}" ToolTip="開く">
                <TextBlock Text="開く"/>
            </Button>
            <Button Command="{Binding SaveCommand}" ToolTip="保存">
                <TextBlock Text="保存"/>
            </Button>
            <Button Command="{Binding SaveAsCommand}" ToolTip="名前を付けて保存">
                <TextBlock Text="名前を付けて保存"/>
            </Button>
            <Separator/>
            <Button Command="{Binding SearchCommand}" ToolTip="検索">
                <TextBlock Text="検索"/>
            </Button>
            <Button Command="{Binding ReplaceCommand}" ToolTip="置換">
                <TextBlock Text="置換"/>
            </Button>
            <Separator/>
            <Button Command="{Binding CompareCommand}" ToolTip="比較">
                <TextBlock Text="比較"/>
            </Button>
        </ToolBar>

        <!-- SearchReplacePanel -->
        <local:SearchReplacePanel
            Grid.Row="2"
            DataContext="{Binding SearchReplacePanelViewModel}"
            Visibility="{Binding IsVisible,
                                 Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <!-- TabControl -->
        <TabControl x:Name="MainTabControl"
                    Grid.Row="3"
                    ItemsSource="{Binding Workspace.Tabs}"
                    SelectedItem="{Binding Workspace.ActiveTab, Mode=TwoWay}"
                    SelectionChanged="MainTabControl_SelectionChanged">
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <ContentControl Content="{Binding}">
                        <ContentControl.Resources>
                            <DataTemplate DataType="{x:Type viewModels:DocumentTabViewModel}">
                                <StackPanel Orientation="Horizontal" ToolTip="{Binding ToolTipText}">
                                    <TextBlock Text="●"
                                               Foreground="#D97706"
                                               FontSize="10"
                                               Margin="0,0,5,0"
                                               VerticalAlignment="Center"
                                               ToolTip="未保存の変更があります">
                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsModified}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding DisplayTitle}"
                                               MaxWidth="220"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type viewModels:DiffTabViewModel}">
                                <TextBlock Text="{Binding DisplayTitle}"
                                           MaxWidth="220"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding DisplayTitle}"/>
                            </DataTemplate>
                        </ContentControl.Resources>
                    </ContentControl>
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <ContentControl Content="{Binding}">
                        <ContentControl.Resources>
                            <DataTemplate DataType="{x:Type viewModels:DocumentTabViewModel}">
                                <local:DocumentView/>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type viewModels:DiffTabViewModel}">
                                <local:DiffView/>
                            </DataTemplate>
                        </ContentControl.Resources>
                    </ContentControl>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>

        <!-- StatusBar -->
        <StatusBar Grid.Row="4">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusEncoding}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding StatusLineEnding}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding StatusCaretPosition}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding StatusModificationState}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding StatusReadOnlyState}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding StatusProcessingState}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
