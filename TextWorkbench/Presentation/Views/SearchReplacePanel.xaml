<UserControl x:Class="TextWorkbench.Presentation.Views.SearchReplacePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="84"
             d:DesignWidth="800">
    <Border Padding="8"
            Background="#F2F2F2"
            BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
            BorderThickness="0,0,0,1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 検索 -->
            <Label Grid.Row="0"
                   Grid.Column="0"
                   Content="検索:"
                   VerticalAlignment="Center"
                   Padding="0,0,8,0"/>

            <TextBox x:Name="SearchTextBox"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Grid.Row="0"
                     Grid.Column="1"
                     MinWidth="220"
                     Margin="0,2,8,2"
                     VerticalContentAlignment="Center">
                <TextBox.Style>
                    <Style TargetType="{x:Type TextBox}">
                        <Setter Property="ToolTip" Value="検索する文字列"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter Property="Background" Value="#FFEBEE"/>
                                <Setter Property="ToolTip" Value="{Binding ErrorMessage}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>

            <StackPanel Grid.Row="0"
                        Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <CheckBox x:Name="RegexCheckBox"
                          Content="正規表現"
                          IsChecked="{Binding IsRegex, Mode=TwoWay}"
                          VerticalAlignment="Center"
                          Margin="0,0,8,0"/>

                <Button x:Name="FindPreviousButton"
                        Content="前へ"
                        MinWidth="56"
                        Margin="0,0,4,0"
                        Command="{Binding DataContext.FindPreviousCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                        ToolTip="前の検索結果へ"/>

                <Button x:Name="FindNextButton"
                        Content="次へ"
                        MinWidth="56"
                        Margin="0,0,4,0"
                        Command="{Binding DataContext.FindNextCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                        ToolTip="次の検索結果へ"/>

                <!-- 検索・置換パネルを閉じる -->
                <Button x:Name="CloseButton"
                        Command="{Binding CloseCommand}"
                        Width="28"
                        Height="26"
                        Padding="0"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="1"
                        Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
                        ToolTip="検索・置換を閉じる">
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="ButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="3">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBorder"
                                            Property="Background"
                                            Value="#D9534F"/>
                                    <Setter TargetName="ButtonBorder"
                                            Property="BorderBrush"
                                            Value="#C9302C"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonBorder"
                                            Property="Background"
                                            Value="#B52B27"/>
                                    <Setter TargetName="ButtonBorder"
                                            Property="BorderBrush"
                                            Value="#A02622"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock Text="×"
                               FontSize="22"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Button>
            </StackPanel>

            <!-- 置換 -->
            <Label Grid.Row="1"
                   Grid.Column="0"
                   Content="置換:"
                   VerticalAlignment="Center"
                   Padding="0,0,8,0"/>

            <TextBox x:Name="ReplaceTextBox"
                     Text="{Binding ReplaceText, UpdateSourceTrigger=PropertyChanged}"
                     Grid.Row="1"
                     Grid.Column="1"
                     MinWidth="220"
                     Margin="0,2,8,2"
                     VerticalContentAlignment="Center"
                     ToolTip="置換後の文字列"/>

            <StackPanel Grid.Row="1"
                        Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button x:Name="ReplaceNextButton"
                        Content="置換"
                        MinWidth="56"
                        Margin="0,0,4,0"
                        Command="{Binding DataContext.ReplaceNextCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                        ToolTip="次の一致箇所を置換"/>

                <Button x:Name="ReplaceAllButton"
                        Content="すべて置換"
                        MinWidth="84"
                        Command="{Binding DataContext.ReplaceAllCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                        ToolTip="文書内の一致箇所をすべて置換"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
