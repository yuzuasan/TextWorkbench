<UserControl x:Class="TextWorkbench.Presentation.Views.SearchReplacePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="84"
             d:DesignWidth="800">
    <Border Padding="8"
            BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
            BorderThickness="0,0,0,1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 検索 -->
            <Label Grid.Row="0"
                   Grid.Column="0"
                   Content="検索:"
                   VerticalAlignment="Center"
                   Padding="0,0,8,0"/>

            <TextBox x:Name="SearchTextBox"
                     Grid.Row="0"
                     Grid.Column="1"
                     MinWidth="220"
                     Margin="0,2,8,2"
                     VerticalContentAlignment="Center"
                     ToolTip="検索する文字列"/>

            <StackPanel Grid.Row="0"
                        Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <CheckBox x:Name="RegexCheckBox"
                          Content="正規表現"
                          VerticalAlignment="Center"
                          Margin="0,0,8,0"/>

                <Button x:Name="FindPreviousButton"
                        Content="前へ"
                        MinWidth="56"
                        Margin="0,0,4,0"
                        ToolTip="前の検索結果へ"/>

                <Button x:Name="FindNextButton"
                        Content="次へ"
                        MinWidth="56"
                        Margin="0,0,4,0"
                        ToolTip="次の検索結果へ"/>

                <!-- 検索・置換パネルを閉じる -->
                <Button x:Name="CloseButton"
                        Content="×"
                        Width="28"
                        ToolTip="検索・置換を閉じる"
                        AutomationProperties.Name="検索・置換を閉じる"/>
            </StackPanel>

            <!-- 置換 -->
            <Label Grid.Row="1"
                   Grid.Column="0"
                   Content="置換:"
                   VerticalAlignment="Center"
                   Padding="0,0,8,0"/>

            <TextBox x:Name="ReplaceTextBox"
                     Grid.Row="1"
                     Grid.Column="1"
                     MinWidth="220"
                     Margin="0,2,8,2"
                     VerticalContentAlignment="Center"
                     ToolTip="置換後の文字列"/>

            <StackPanel Grid.Row="1"
                        Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button x:Name="ReplaceNextButton"
                        Content="置換"
                        MinWidth="56"
                        Margin="0,0,4,0"
                        ToolTip="次の一致箇所を置換"/>

                <Button x:Name="ReplaceAllButton"
                        Content="すべて置換"
                        MinWidth="84"
                        ToolTip="文書内の一致箇所をすべて置換"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
