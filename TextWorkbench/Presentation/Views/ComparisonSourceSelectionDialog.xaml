<Window x:Class="TextWorkbench.Presentation.Views.ComparisonSourceSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="比較対象の選択"
        Width="600"
        Height="250"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左側の選択UI -->
        <GroupBox Grid.Row="0" Grid.Column="0"
                  Header="左側の比較元"
                  Margin="0,0,8,0"
                  Padding="8">
            <StackPanel>
                <TextBlock Text="開いているドキュメント"
                           FontWeight="SemiBold"
                           Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding DocumentCandidates}"
                          SelectedItem="{Binding LeftSelection.DocumentTabSelection}"
                          DisplayMemberPath="DisplayTitle"
                          IsEnabled="{Binding HasDocumentCandidates}"
                          Margin="0,0,0,8"/>

                <Button Content="保存済みファイルを選択"
                        Command="{Binding SelectLeftFileCommand}"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,8"/>

                <TextBlock Text="{Binding LeftSelection.SourceDisplayName}"
                           ToolTip="{Binding LeftSelection.ToolTipText}"
                           FontWeight="SemiBold"
                           Margin="0,0,0,0"/>
            </StackPanel>
        </GroupBox>

        <!-- 中央の区切り -->
        <TextBlock Grid.Row="0" Grid.Column="1"
                   Text="↔"
                   FontSize="24"
                   FontWeight="Bold"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   Margin="8,0"/>

        <!-- 右側の選択UI -->
        <GroupBox Grid.Row="0" Grid.Column="2"
                  Header="右側の比較元"
                  Margin="8,0,0,0"
                  Padding="8">
            <StackPanel>
                <TextBlock Text="開いているドキュメント"
                           FontWeight="SemiBold"
                           Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding DocumentCandidates}"
                          SelectedItem="{Binding RightSelection.DocumentTabSelection}"
                          DisplayMemberPath="DisplayTitle"
                          IsEnabled="{Binding HasDocumentCandidates}"
                          Margin="0,0,0,8"/>

                <Button Content="保存済みファイルを選択"
                        Command="{Binding SelectRightFileCommand}"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,8"/>

                <TextBlock Text="{Binding RightSelection.SourceDisplayName}"
                           ToolTip="{Binding RightSelection.ToolTipText}"
                           FontWeight="SemiBold"
                           Margin="0,0,0,0"/>
            </StackPanel>
        </GroupBox>

        <!-- ボタン -->
        <StackPanel Grid.Row="1" Grid.ColumnSpan="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="比較"
                    Command="{Binding ExecuteCompareCommand}"
                    IsDefault="True"
                    MinWidth="80"
                    Margin="0,0,8,0"/>
            <Button Content="キャンセル"
                    Command="{Binding CancelCommand}"
                    IsCancel="True"
                    MinWidth="80"/>
        </StackPanel>
    </Grid>
</Window>
