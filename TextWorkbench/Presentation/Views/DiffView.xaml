<UserControl x:Class="TextWorkbench.Presentation.Views.DiffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:diffplex="clr-namespace:DiffPlex.Wpf.Controls;assembly=DiffPlex.Wpf"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 比較対象のファイル名 -->
        <Border Grid.Row="0" Grid.Column="0"
                Padding="8,5"
                BorderBrush="{DynamicResource DiffViewerHeaderBorderBrush}"
                BorderThickness="0,0,1,1"
                Background="{DynamicResource DiffViewerHeaderBackgroundBrush}">
            <TextBlock Text="{Binding DiffSession.LeftSource.DisplayName}"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding DiffSession.LeftSource.FilePath}"/>
        </Border>
        <Border Grid.Row="0" Grid.Column="1"
                Padding="8,5"
                BorderBrush="{DynamicResource DiffViewerHeaderBorderBrush}"
                BorderThickness="0,0,0,1"
                Background="{DynamicResource DiffViewerHeaderBackgroundBrush}">
            <TextBlock Text="{Binding DiffSession.RightSource.DisplayName}"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding DiffSession.RightSource.FilePath}"/>
        </Border>

        <!-- Diff計算は行わず、DiffSession.Resultを表示用モデルへ変換して描画する -->
        <diffplex:SideBySideDiffViewer x:Name="SideBySideViewer"
                                       Grid.Row="1"
                                       Grid.ColumnSpan="2"
                                       Margin="0"
                                       FontFamily="Meiryo"
                                       FontSize="14"
                                       LineNumberForeground="{DynamicResource DiffLineNumberForegroundBrush}"
                                       ChangeTypeForeground="{DynamicResource DiffChangeTypeForegroundBrush}"
                                       InsertedBackground="{DynamicResource DiffAddedBackgroundBrush}"
                                       DeletedBackground="{DynamicResource DiffDeletedBackgroundBrush}"
                                       UnchangedBackground="{DynamicResource DiffUnchangedBackgroundBrush}"
                                       ImaginaryBackground="{DynamicResource DiffImaginaryBackgroundBrush}"
                                       SplitterBackground="{DynamicResource DiffSplitterBackgroundBrush}"
                                       SplitterBorderBrush="{DynamicResource DiffSplitterBorderBrush}"
                                       SplitterBorderThickness="0"/>
    </Grid>
</UserControl>
